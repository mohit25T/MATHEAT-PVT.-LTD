# ============================================================
# MATHEAT PVT. LTD. — Root .gitignore
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
build/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# OS generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Vite / React build cache
.vite/
*.local

# Test coverage
coverage/
.nyc_output/

# TypeScript cache
*.tsbuildinfo

# Temporary files
*.tmp
*.temp
tmp/
temp/

# PDF test files
*.pdf

# Uploaded / generated assets that shouldn't be tracked
assets/temp/
public/temp/
